generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id       String    @id @default(uuid())
  type     UserType? @default(USERNAME)
  googleId String?   @unique
  githubId String?   @unique

  avatarUrl String?
  firstName String
  lastName  String?
  username  String  @unique
  password  String?

  posts         Post[]    @relation(name: "UserPosts")
  likedPosts    Post[]    @relation(name: "UserLikedPosts")
  comments      Comment[] @relation(name: "CommentsToUser")
  likedComments Comment[]
  friends       User[]    @relation("UserFriends")
  symFriends    User[]    @relation("UserFriends")

  settings Settings?

  chats    Chat[]
  messages Message[]

  sentRequests     FriendRequest[] @relation("Sender")
  receivedRequests FriendRequest[] @relation("Receiver")
  createdAt        DateTime        @default(now())
  lastSeen         DateTime?
}

enum UserType {
  USERNAME
  GOOGLE
  GITHUB
}

model Settings {
  id           String       @id @default(ulid())
  userId       String       @unique
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  is24h        Boolean      @default(true)
  whoCanTextMe WhoCanTextMe @default(EVERYONE)
  theme        String       @default("DEFAULT")
  updatedAt    DateTime     @updatedAt
}

enum WhoCanTextMe {
  EVERYONE
  FRIENDS
}

model FriendRequest {
  id         String   @id @default(uuid())
  senderId   String
  receiverId String
  createdAt  DateTime @default(now())

  sender   User @relation("Sender", fields: [senderId], references: [id], onDelete: Cascade)
  receiver User @relation("Receiver", fields: [receiverId], references: [id], onDelete: Cascade)

  @@unique([senderId, receiverId])
}

model Post {
  id        String    @id @default(uuid())
  imageUrl  String?
  content   String?
  author    User      @relation(name: "UserPosts", fields: [authorId], references: [id], onDelete: Cascade)
  authorId  String
  comments  Comment[]
  likedBy   User[]    @relation(name: "UserLikedPosts")
  createdAt DateTime  @default(now())
}

model Comment {
  id        String   @id @default(uuid())
  content   String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade, name: "CommentsToUser")
  authorId  String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId    String
  likedBy   User[]
  createdAt DateTime @default(now())
}

model Chat {
  id         String    @id @default(uuid())
  users      User[]
  messages   Message[]
  createdAt  DateTime  @default(now())
  lastUpdate DateTime? @updatedAt
}

model Message {
  id        String   @id @default(uuid())
  imageUrl  String?
  content   String?
  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  chatId    String
  chat      Chat     @relation(fields: [chatId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  isRead    Boolean  @default(false)

  @@index([chatId])
}
